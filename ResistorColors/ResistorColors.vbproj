<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <ApplicationIcon>output_20261025_065346.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="bin\Debug\net10.0-windows\Draw.xml" />
    <Content Include="bin\Debug\net10.0-windows\ResistorColors.deps.json" />
    <Content Include="bin\Debug\net10.0-windows\ResistorColors.runtimeconfig.json" />
    <Content Include="output_20261025_065346.ico" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Include="bin\Debug\net10.0-windows\Draw.dll" />
    <None Include="bin\Debug\net10.0-windows\Draw.pdb" />
    <None Include="bin\Debug\net10.0-windows\ResistorColors.dll" />
    <None Include="bin\Debug\net10.0-windows\ResistorColors.exe" />
    <None Include="bin\Debug\net10.0-windows\ResistorColors.pdb" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Draw">
      <HintPath>..\..\Popular\DLLs\Draw\Draw\bin\Debug\Draw.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

</Project>